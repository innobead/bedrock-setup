{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PauseBedrockModelUsage",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:CreateModelInvocationJob",
        "bedrock:CallWithBearerToken"
      ],
      "Resource": "*"
    }
  ]
}
